require('dotenv').config();
const express=require('express'),mongoose=require('mongoose'),path=require('path'),cors=require('cors');
const app=express();
app.use(cors());app.use(express.json({limit:'1mb'}));
app.use('/api/auth',require('./src/routes/auth'));
app.use('/api/transactions',require('./src/middleware/auth'),require('./src/routes/transactions'));
app.use('/api/budgets',require('./src/middleware/auth'),require('./src/routes/budgets'));
app.use('/api/summary',require('./src/middleware/auth'),require('./src/routes/summary'));
app.use(express.static(path.join(__dirname,'../frontend/public')));
app.get('/api/health',(req,res)=>res.json({status:'ok',database:mongoose.connection.readyState===1?'connected':'disconnected'}));
app.get('*',(req,res)=>res.sendFile(path.join(__dirname,'../frontend/public/index.html')));
const port=process.env.PORT||3000;
mongoose.connect(process.env.MONGODB_URI).then(()=>app.listen(port,()=>console.log('App running on port '+port))).catch(e=>{console.error('MongoDB connection failed:',e.message);process.exit(1);});
